//@version=6
indicator("SMC PRO AI v0.1.1", overlay=true, max_labels_count=500, max_lines_count=500)

//====================================================
// VERSION
//====================================================
const string VERSION = "0.1.1"

//====================================================
// INPUTS
//====================================================
groupGeneral = "General"
groupPivot = "Pivot Engine"

showMajor = input.bool(true, "Show Major Pivots", group=groupPivot)
showMinor = input.bool(true, "Show Minor Pivots", group=groupPivot)

majorLen = input.int(10, "Major Swing Length", minval=2, maxval=50, group=groupPivot)
minorLen = input.int(3, "Minor Swing Length", minval=2, maxval=20, group=groupPivot)

debugMode = input.bool(false, "Debug Mode", group=groupGeneral)

//====================================================
// MARKET MEMORY
//====================================================
//====================================================
// MARKET STRUCTURE ENGINE
//====================================================

// Trend State
enum TrendState
    Neutral
    Bullish
    Bearish

var TrendState trendState = TrendState.Neutral

enum SwingClass
    None
    HH
    HL
    LH
    LL

var float lastMajorHigh = na
var float previousMajorHigh = na

var float lastMajorLow = na
var float previousMajorLow = na

var SwingClass currentHighClass = SwingClass.None
var SwingClass currentLowClass = SwingClass.None

var int lastMajorHighBar = na
var int lastMajorLowBar = na

//====================================================
// BOS / CHoCH MEMORY
//====================================================

var float lastBullishBOS = na
var float lastBearishBOS = na

var bool bullishBOS = false
var bool bearishBOS = false

var bool bullishCHoCH = false
var bool bearishCHoCH = false

//====================================================
// Major swings
var majorHighPrices = array.new_float()
var majorHighBars   = array.new_int()

var majorLowPrices  = array.new_float()
var majorLowBars    = array.new_int()

//====================================================
// TREND ENGINE
//====================================================

if currentHighClass == SwingClass.HH and currentLowClass == SwingClass.HL
    trendState := TrendState.Bullish

if currentHighClass == SwingClass.LH and currentLowClass == SwingClass.LL
    trendState := TrendState.Bearish

// Minor swings
var minorHighPrices = array.new_float()
var minorHighBars   = array.new_int()

var minorLowPrices  = array.new_float()
var minorLowBars    = array.new_int()

//====================================================
// PIVOT ENGINE
//====================================================

// Detect confirmed pivots
majorPH = ta.pivothigh(high, majorLen, majorLen)
majorPL = ta.pivotlow(low, majorLen, majorLen)

minorPH = ta.pivothigh(high, minorLen, minorLen)
minorPL = ta.pivotlow(low, minorLen, minorLen)

// Reset structure events
bullishBOS := false
bearishBOS := false
bullishCHoCH := false
bearishCHoCH := false

// Store confirmed pivots
// Store confirmed Major High

if not na(majorPH)
    bool isNewHigh = array.size(majorHighPrices) == 0 or array.get(majorHighPrices, array.size(majorHighPrices) - 1) != majorPH

    if isNewHigh
        previousMajorHigh := lastMajorHigh
        lastMajorHigh := majorPH
        lastMajorHighBar := bar_index - majorLen

        if not na(previousMajorHigh)
            currentHighClass := lastMajorHigh > previousMajorHigh ? SwingClass.HH : SwingClass.LH

        array.push(majorHighPrices, majorPH)
        array.push(majorHighBars, bar_index - majorLen)

//====================================================
// BULLISH BOS
//====================================================

if not na(lastMajorHigh)
    if close > lastMajorHigh and close[1] <= lastMajorHigh
        bullishBOS := true
        lastBullishBOS := lastMajorHigh

// Store confirmed Major Low
if not na(majorPL)
    bool isNewLow = array.size(majorLowPrices) == 0 or array.get(majorLowPrices, array.size(majorLowPrices) - 1) != majorPL

    if isNewLow
        previousMajorLow := lastMajorLow
        lastMajorLow := majorPL
        lastMajorLowBar := bar_index - majorLen

        if not na(previousMajorLow)
            currentLowClass := lastMajorLow > previousMajorLow ? SwingClass.HL : SwingClass.LL

        array.push(majorLowPrices, majorPL)
        array.push(majorLowBars, bar_index - majorLen)

//====================================================
// BEARISH BOS
//====================================================

if not na(lastMajorLow)
    if close < lastMajorLow and close[1] >= lastMajorLow
        bearishBOS := true
        lastBearishBOS := lastMajorLow

//====================================================
// DRAWING
//====================================================

plotshape(
     showMajor and not na(majorPH),
     title="Major High",
     style=shape.triangledown,
     location=location.abovebar,
     offset=-majorLen,
     size=size.small,
     color=color.red)

plotshape(
     showMajor and not na(majorPL),
     title="Major Low",
     style=shape.triangleup,
     location=location.belowbar,
     offset=-majorLen,
     size=size.small,
     color=color.lime)

plotshape(
     showMinor and not na(minorPH),
     title="Minor High",
     style=shape.circle,
     location=location.abovebar,
     offset=-minorLen,
     size=size.tiny,
     color=color.orange)

plotshape(
     showMinor and not na(minorPL),
     title="Minor Low",
     style=shape.circle,
     location=location.belowbar,
     offset=-minorLen,
     size=size.tiny,
     color=color.aqua)

//====================================================
// MARKET STRUCTURE LABELS
//====================================================

if not na(majorPH) and currentHighClass != SwingClass.None

    label.new(
         bar_index - majorLen,
         majorPH,
         str.tostring(currentHighClass),
         style=label.style_label_down,
         color=currentHighClass == SwingClass.HH ? color.green : color.red,
         textcolor=color.white)

if not na(majorPL) and currentLowClass != SwingClass.None

    label.new(
         bar_index - majorLen,
         majorPL,
         str.tostring(currentLowClass),
         style=label.style_label_up,
         color=currentLowClass == SwingClass.HL ? color.green : color.red,
         textcolor=color.white)

//====================================================
// BOS LABELS
//====================================================

if bullishBOS
    label.new(
         bar_index,
         high,
         "BOS",
         style=label.style_label_down,
         color=color.green,
         textcolor=color.white)

if bearishBOS
    label.new(
         bar_index,
         low,
         "BOS",
         style=label.style_label_up,
         color=color.red,
         textcolor=color.white)

//====================================================
// DEBUG
//====================================================

if debugMode and barstate.islast
    string trendText =
         trendState == TrendState.Bullish ? "Bullish" :
         trendState == TrendState.Bearish ? "Bearish" :
         "Neutral"

    label.new(
         bar_index,
         high,
         "SMC PRO AI " + VERSION +
         "\nTrend: " + trendText +
         "\nLast High: " + str.tostring(lastMajorHigh) +
         "\nPrev High: " + str.tostring(previousMajorHigh) +
         "\nLast Low: " + str.tostring(lastMajorLow) +
         "\nPrev Low: " + str.tostring(previousMajorLow),
         style=label.style_label_left,
         color=color.black,
         textcolor=color.white)